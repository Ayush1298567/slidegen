# Get a key from https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key.
GOOGLE_API_KEY=

# --- Optional: DeepSeek (alternative to Claude for planning/refining) ---
# Claude is the default. To use DeepSeek instead, either:
#   1. Pick "DeepSeek" in the app's planner UI, or
#   2. Force it server-side with:  SLIDEGEN_PROVIDER=deepseek
# You still need a DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional DeepSeek overrides (defaults shown):
# SLIDEGEN_PROVIDER=claude
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat        # or deepseek-reasoner
# DEEPSEEK_INPUT_USD_PER_MTOKEN=0.27
# DEEPSEEK_OUTPUT_USD_PER_MTOKEN=1.10

# When DeepSeek is the planner, per-slide image review is done by a Gemini
# vision model (DeepSeek is text-only). Override the reviewer model if needed:
# SLIDEGEN_GEMINI_REVIEW_MODEL=gemini-2.5-flash
